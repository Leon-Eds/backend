<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Report Card</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap');
        body { font-family: 'Inter', sans-serif; -webkit-print-color-adjust: exact; print-color-adjust: exact; margin: 0; padding: 0; }
        .page-break { page-break-after: always; break-after: page; }
    </style>
</head>
<body class="bg-white text-black text-sm">
    <div id="result-pdf-content" class="w-full bg-white p-8">
        
        <!-- PAGE 1 -->
        <div class="page-break flex flex-col pt-4">
            <!-- Header -->
            <div class="flex justify-between items-center border-b-2 border-[#053d26] pb-4 mb-3">
                <div class="w-20 h-20 shrink-0 rounded-full border-4 border-[#b45309] bg-[#053d26] text-white flex items-center justify-center overflow-hidden flex-col">
                    {{#if schoolLogo}}
                    <img src="{{schoolLogo}}" alt="School Logo" class="w-full h-full object-cover rounded-full" />
                    {{else}}
                    <span class="text-[10px] font-bold mt-1 tracking-wider">SCH</span>
                    {{/if}}
                </div>
                <div class="text-center flex-1 px-4">
                    <h1 class="text-2xl sm:text-3xl font-black text-[#053d26] uppercase tracking-wide">
                        {{schoolName}}
                    </h1>
                    <p class="text-[#b45309] font-bold italic tracking-widest text-sm mt-1">{{schoolAddress}}</p>
                </div>
            </div>
            
            <div class="text-center py-2 mb-4 border-b border-gray-300 mx-16">
                <h2 class="text-xl font-bold text-[#053d26] tracking-[0.2em] uppercase">Terminal Academic Report</h2>
                <p class="text-[#b45309] text-xs font-bold uppercase tracking-widest italic mt-1">{{termLabel}}</p>
            </div>

            <!-- Student Details -->
            <div class="bg-[#f8fafc] p-6 mb-6 border border-gray-100 flex flex-row items-start justify-between gap-6">
                <div class="grid grid-cols-2 gap-y-3 gap-x-8 text-xs flex-1">
                    <div class="flex"><span class="w-32 font-bold text-[#053d26]">Student's Name:</span> <span class="font-medium text-gray-800">{{studentName}}</span></div>
                    <div class="flex"><span class="w-32 font-bold text-[#053d26]">Admission No.:</span> <span class="font-medium text-gray-800">{{admissionNumber}}</span></div>
                    <div class="flex"><span class="w-32 font-bold text-[#053d26]">Class:</span> <span class="font-medium text-gray-800">{{className}}</span></div>
                    <div class="flex"><span class="w-32 font-bold text-[#053d26]">Gender:</span> <span class="font-medium text-gray-800">{{gender}}</span></div>
                    <div class="flex"><span class="w-32 font-bold text-[#053d26]">Term:</span> <span class="font-medium text-gray-800">{{termLabel}}</span></div>
                    <div class="flex"><span class="w-32 font-bold text-[#053d26]">Session:</span> <span class="font-medium text-gray-800">{{sessionName}}</span></div>
                    <div class="flex"><span class="w-32 font-bold text-[#053d26]">No. in Class:</span> <span class="font-medium text-gray-800">{{classSize}}</span></div>
                    <div class="flex"><span class="w-32 font-bold text-[#053d26]">Position in Class:</span> <span class="font-medium text-gray-800">{{position}}</span></div>
                    <div class="flex"><span class="w-32 font-bold text-[#053d26]">Days School Opened:</span> <span class="font-medium text-gray-800">{{daysOpened}}</span></div>
                    <div class="flex"><span class="w-32 font-bold text-[#053d26]">Days Present:</span> <span class="font-medium text-gray-800">{{daysPresent}}</span></div>
                    <div class="flex"><span class="w-32 font-bold text-[#053d26]">Next Term Begins:</span> <span class="font-medium text-gray-800">{{nextTermBegins}}</span></div>
                </div>
                <div class="flex w-24 h-24 shrink-0 rounded-md border-4 border-white shadow-sm bg-gray-100 items-center justify-center overflow-hidden relative self-start">
                    {{#if studentPassport}}
                    <img src="{{studentPassport}}" alt="Student Passport" class="w-full h-full object-cover z-10 relative bg-white" />
                    {{else}}
                    <span class="text-gray-400 text-[10px] font-bold absolute z-0 text-center opacity-30">NO<br/>PHOTO</span>
                    {{/if}}
                </div>
            </div>

            <!-- Academic Performance -->
            <h3 class="text-[13px] font-black text-[#053d26] tracking-widest uppercase mb-2">Academic Performance</h3>
            <div class="border-t-[3px] border-[#053d26]">
                <table class="w-full text-xs text-center border-collapse mb-4">
                    <thead>
                        <tr class="bg-[#053d26] text-white">
                            <th class="py-2.5 px-3 text-left w-[25%] border border-[#053d26] font-bold">SUBJECT</th>
                            <th class="py-2.5 px-1 border border-[#053d26] font-bold leading-tight">CA 1<br/><span class="text-[9px] font-normal">(20)</span></th>
                            <th class="py-2.5 px-1 border border-[#053d26] font-bold leading-tight">CA 2<br/><span class="text-[9px] font-normal">(20)</span></th>
                            <th class="py-2.5 px-1 border border-[#053d26] font-bold leading-tight">EXAM<br/><span class="text-[9px] font-normal">(60)</span></th>
                            <th class="py-2.5 px-1 border border-[#053d26] font-bold leading-tight">TOTAL<br/><span class="text-[9px] font-normal">(100)</span></th>
                            <th class="py-2.5 px-1 border border-[#053d26] font-bold">GRADE</th>
                            <th class="py-2.5 px-1 border border-[#053d26] font-bold leading-tight">CLASS<br/>AVG</th>
                            <th class="py-2.5 px-1 border border-[#053d26] font-bold">POS</th>
                            <th class="py-2.5 px-2 border border-[#053d26] w-[20%] font-bold">REMARK</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each grades}}
                        <tr class="{{this.rowBgClass}}">
                            <td class="py-2 px-3 text-left font-bold text-[#053d26] border border-gray-300">{{this.subjectName}}</td>
                            <td class="py-2 px-1 border border-gray-300 text-gray-700">{{this.ca1}}</td>
                            <td class="py-2 px-1 border border-gray-300 text-gray-700">{{this.ca2}}</td>
                            <td class="py-2 px-1 border border-gray-300 text-gray-700">{{this.exam}}</td>
                            <td class="py-2 px-1 border border-gray-300 font-black text-[#053d26]">{{this.total}}</td>
                            <td class="py-2 px-1 border border-gray-300 font-bold text-[#053d26]">{{this.grade}}</td>
                            <td class="py-2 px-1 border border-gray-300 text-gray-700">{{this.classAvg}}</td>
                            <td class="py-2 px-1 border border-gray-300 text-gray-700">{{this.pos}}</td>
                            <td class="py-2 px-2 border border-gray-300 text-gray-700 text-xs">{{this.remark}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                    <tfoot>
                        <tr class="bg-[#f0fdf4] font-bold text-[#053d26] border-t-2 border-[#053d26]">
                            <td colspan="4" class="py-3 px-4 text-left border border-gray-300 uppercase">CUMULATIVE SCORE: {{totalStudentScore}} / {{maxPossibleScore}}</td>
                            <td colspan="2" class="py-3 px-4 text-center border border-gray-300 uppercase">AVERAGE: {{averageScore}}%</td>
                            <td colspan="2" class="py-3 px-4 text-right border border-gray-300 uppercase">POSITION: {{position}}</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Grading Key -->
            <div class="mt-4 pb-4">
                <h4 class="text-xs font-bold text-[#053d26] mb-2">Grading Key</h4>
                <div class="flex flex-wrap gap-x-8 gap-y-2 text-[11px] text-gray-600 font-medium">
                    <div><span class="font-bold text-[#053d26]">A</span> 70-100 (Excellent)</div>
                    <div><span class="font-bold text-[#053d26]">B</span> 60-69 (Very Good)</div>
                    <div><span class="font-bold text-[#053d26]">C</span> 50-59 (Good)</div>
                    <div><span class="font-bold text-[#053d26]">D</span> 45-49 (Fair)</div>
                    <div><span class="font-bold text-[#053d26]">E</span> 40-44 (Poor)</div>
                    <div><span class="font-bold text-[#053d26]">F</span> 0-39 (Fail)</div>
                </div>
            </div>
        </div>

        <!-- PAGE 2 -->
        <div class="page-break flex flex-col text-sm border-t border-gray-300 pt-12 mt-12">
            <div class="flex justify-between items-center border-b border-gray-300 pb-2 mb-6 text-xs font-bold text-[#053d26]">
                <span class="uppercase">{{schoolName}}</span>
                <span class="text-gray-300">|</span>
                <span>Student: {{studentName}}</span>
                <span class="text-gray-300">|</span>
                <span>Adm. No: {{admissionNumber}}</span>
            </div>

            <h3 class="text-sm font-bold text-[#053d26] tracking-widest uppercase mb-1 border-b-[2.5px] border-[#b45309] pb-1 inline-block w-full">Affective & Psychomotor Domains</h3>
            <p class="text-[11px] text-gray-500 italic mb-4">Non-academic assessment of behaviour, character and practical skills.</p>

            <div class="flex flex-row gap-6 mb-2">
                <div class="flex-1">
                    <table class="w-full text-xs text-left border-collapse">
                        <thead>
                            <tr class="bg-[#053d26] text-white">
                                <th class="py-2 px-3 border border-[#053d26]">BEHAVIOUR (AFFECTIVE)</th>
                                <th class="py-2 px-3 border border-[#053d26] text-center w-20">RATING</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="bg-[#f8fafc]">
                                <td class="py-2.5 px-3 border border-gray-300 text-gray-700 font-medium">Punctuality</td>
                                <td class="py-2.5 px-3 border border-gray-300 text-center font-bold text-[#053d26]">{{punctualityScore}}</td>
                            </tr>
                            <tr class="bg-white">
                                <td class="py-2.5 px-3 border border-gray-300 text-gray-700 font-medium">Neatness</td>
                                <td class="py-2.5 px-3 border border-gray-300 text-center font-bold text-[#053d26]">{{neatnessScore}}</td>
                            </tr>
                            <tr class="bg-[#f8fafc]">
                                <td class="py-2.5 px-3 border border-gray-300 text-gray-700 font-medium">Politeness</td>
                                <td class="py-2.5 px-3 border border-gray-300 text-center font-bold text-[#053d26]">{{politenessScore}}</td>
                            </tr>
                            <tr class="bg-white">
                                <td class="py-2.5 px-3 border border-gray-300 text-gray-700 font-medium">Honesty</td>
                                <td class="py-2.5 px-3 border border-gray-300 text-center font-bold text-[#053d26]">{{honestyScore}}</td>
                            </tr>
                            <tr class="bg-[#f8fafc]">
                                <td class="py-2.5 px-3 border border-gray-300 text-gray-700 font-medium">Cooperation</td>
                                <td class="py-2.5 px-3 border border-gray-300 text-center font-bold text-[#053d26]">{{cooperationScore}}</td>
                            </tr>
                            <tr class="bg-white">
                                <td class="py-2.5 px-3 border border-gray-300 text-gray-700 font-medium">Peer Relationship</td>
                                <td class="py-2.5 px-3 border border-gray-300 text-center font-bold text-[#053d26]">{{peerRelationshipScore}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="flex-1">
                    <table class="w-full text-xs text-left border-collapse">
                        <thead>
                            <tr class="bg-[#053d26] text-white">
                                <th class="py-2 px-3 border border-[#053d26]">SKILLS (PSYCHOMOTOR)</th>
                                <th class="py-2 px-3 border border-[#053d26] text-center w-20">RATING</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="bg-[#f8fafc]">
                                <td class="py-2.5 px-3 border border-gray-300 text-gray-700 font-medium">Handwriting</td>
                                <td class="py-2.5 px-3 border border-gray-300 text-center font-bold text-[#053d26]">{{handwritingScore}}</td>
                            </tr>
                            <tr class="bg-white">
                                <td class="py-2.5 px-3 border border-gray-300 text-gray-700 font-medium">Public Speaking</td>
                                <td class="py-2.5 px-3 border border-gray-300 text-center font-bold text-[#053d26]">{{publicSpeakingScore}}</td>
                            </tr>
                            <tr class="bg-[#f8fafc]">
                                <td class="py-2.5 px-3 border border-gray-300 text-gray-700 font-medium">Sports & Athletics</td>
                                <td class="py-2.5 px-3 border border-gray-300 text-center font-bold text-[#053d26]">{{sportsScore}}</td>
                            </tr>
                            <tr class="bg-white">
                                <td class="py-2.5 px-3 border border-gray-300 text-gray-700 font-medium">Club Participation</td>
                                <td class="py-2.5 px-3 border border-gray-300 text-center font-bold text-[#053d26]">{{clubParticipationScore}}</td>
                            </tr>
                            <tr class="bg-[#f8fafc]">
                                <td class="py-2.5 px-3 border border-gray-300 text-gray-700 font-medium">Craft / Lab Skills</td>
                                <td class="py-2.5 px-3 border border-gray-300 text-center font-bold text-[#053d26]">{{craftScore}}</td>
                            </tr>
                            <tr class="bg-white">
                                <td class="py-2.5 px-3 border border-gray-300 text-gray-700 font-medium">Musical Skill</td>
                                <td class="py-2.5 px-3 border border-gray-300 text-center font-bold text-[#053d26]">{{musicalSkillScore}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <p class="text-[10px] text-gray-500 italic mb-8 border-b border-gray-200 pb-4">Rating scale: 5 = Excellent, 4 = Good, 3 = Fair, 2 = Weak, 1 = Poor</p>

            <div class="grid grid-cols-2 gap-8 flex-1">
                <div class="flex flex-col justify-between">
                    <div>
                        <h4 class="text-sm font-bold text-[#053d26] mb-2">Form Teacher's Remark</h4>
                        <div class="pl-4 border-l-4 border-[#b45309] text-sm text-gray-700 italic mb-4 min-h-[40px]">
                            {{teacherRemark}}
                        </div>
                    </div>
                    <div class="flex flex-col items-center mt-4">
                        {{#if teacherSignature}}
                        <img src="{{teacherSignature}}" alt="Teacher Signature" class="h-10 mb-1 object-contain" />
                        {{else}}
                        <div class="h-10 mb-1"></div>
                        {{/if}}
                        <div class="w-48 border-t border-gray-400 mb-2"></div>
                        <div class="text-center text-xs">
                            <span class="font-bold">Form Teacher</span><br/>
                            <span>Teacher's Name: {{teacherName}}</span>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col justify-end">
                    <div class="flex flex-col items-center mt-4">
                        {{#if principalSignature}}
                        <img src="{{principalSignature}}" alt="Principal Signature" class="h-10 mb-1 object-contain" />
                        {{else}}
                        <div class="h-10 mb-1"></div>
                        {{/if}}
                        <div class="w-48 border-t border-gray-400 mb-2"></div>
                        <div class="text-center text-xs">
                            <span class="font-bold">Principal / Head of School</span><br/>
                            <span>Principal's Name: {{principalName}}</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-8 mb-4 border border-blue-200 bg-[#f0fdf4] flex justify-between p-3 px-4 text-xs font-bold text-[#053d26]">
                <span>PROMOTED TO: {{promotedTo}}</span>
                <span>NEXT TERM BEGINS: {{nextTermBegins}}</span>
            </div>

            <div class="flex justify-between items-start mt-4 relative">
                <div class="text-[10px] text-gray-500 italic max-w-sm pt-4">
                    <strong class="block text-[#053d26] mb-1 font-bold">Authentication</strong>
                    This report is official only when it bears the school's embossed stamp and the Principal's original signature above.
                </div>
                <div class="w-28 h-28 rounded-full border-2 border-dashed border-[#053d26] flex items-center justify-center text-center p-2 opacity-60 shrink-0 right-4 top-2 relative">
                    <span class="text-[9px] font-bold text-[#053d26] leading-tight flex flex-col gap-1">
                        OFFICIAL<br/>SCHOOL STAMP
                        <span class="text-[6px] font-normal leading-[1] mt-1 text-[#b45309] uppercase">{{schoolName}}</span>
                    </span>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ID Card</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap');
        body { font-family: 'Inter', sans-serif; -webkit-print-color-adjust: exact; print-color-adjust: exact; margin: 0; padding: 20px; background-color: #f3f4f6; }
        .icon { width: 12px; height: 12px; fill: none; stroke: white; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    </style>
</head>
<body class="flex gap-6 justify-center items-center">

    <!-- FRONT CARD -->
    <div 
        class="bg-white overflow-hidden shadow-xl relative flex flex-col shrink-0"
        style="width: 3.375in; height: 5.375in; border-radius: 1rem;"
    >
        <!-- Lanyard Hole -->
        <div class="absolute top-2 left-1/2 -translate-x-1/2 w-14 h-3 bg-gray-100 rounded-full z-50 shadow-inner border border-gray-200"></div>

        <!-- Top Background Shape -->
        <div class="absolute top-0 left-0 w-full h-32 z-0">
            <svg viewBox="0 0 100 100" class="w-full h-full" preserveAspectRatio="none">
                <path d="M0,0 L100,0 L100,60 C70,90 30,70 0,50 Z" fill="{{themeColor}}"/>
                <path d="M0,50 C30,70 70,90 100,60 L100,65 C70,95 30,75 0,55 Z" fill="{{accentColor}}"/>
            </svg>
        </div>

        <div class="flex-1 flex flex-col items-center px-6 pt-12 relative z-10 w-full">
            <!-- School Logo & Name -->
            <div class="flex flex-col items-center mb-3">
                {{#if schoolLogo}}
                <img src="{{schoolLogo}}" alt="School Logo" class="h-10 object-contain mb-1" />
                {{else}}
                <div class="h-10 w-10 rounded-full bg-white text-gray-900 flex items-center justify-center font-black text-xl mb-1 shadow-sm">{{schoolInitial}}</div>
                {{/if}}
            </div>

            <!-- Photo -->
            <div class="w-28 h-32 rounded-2xl overflow-hidden bg-gray-50 border-[3px] border-white shadow-[0_0_15px_rgba(0,0,0,0.1)] mb-3 relative">
                {{#if studentPassport}}
                <img src="{{studentPassport}}" alt="{{studentName}}" class="w-full h-full object-cover" />
                {{else}}
                <div class="w-full h-full flex items-center justify-center bg-gray-200 text-gray-400 text-[10px] font-bold">NO PHOTO</div>
                {{/if}}
            </div>

            <!-- Name and Pill -->
            <h2 class="text-sm font-black text-gray-900 uppercase tracking-wide text-center leading-tight mb-1" style="color: {{themeColor}};">
                {{studentName}}
            </h2>
            <div class="px-4 py-0.5 rounded-full text-[10px] font-bold text-white uppercase tracking-widest mb-4" style="background-color: {{accentColor}};">
                STUDENT
            </div>

            <!-- Details List -->
            <div class="w-full space-y-2.5 mt-2">
                <div class="flex items-center gap-3">
                    <div class="w-5 h-5 rounded flex items-center justify-center shrink-0" style="background-color: {{themeColor}};">
                        <svg class="icon" viewBox="0 0 24 24"><path d="M16 10h2M16 14h2M6.17 15a3 3 0 0 1 5.66 0M9 11a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><rect width="18" height="18" x="3" y="3" rx="2"/></svg>
                    </div>
                    <div class="flex text-[10px] font-bold">
                        <span class="text-gray-500 w-20">STUDENT ID:</span>
                        <span class="text-gray-900 uppercase">{{admissionNumber}}</span>
                    </div>
                </div>
                
                <div class="flex items-center gap-3">
                    <div class="w-5 h-5 rounded flex items-center justify-center shrink-0" style="background-color: {{themeColor}};">
                        <svg class="icon" viewBox="0 0 24 24"><path d="M21.42 10.922a2 2 0 0 1-.01 3.016l-7.98 8a2 2 0 0 1-2.827 0l-8.003-8a2 2 0 0 1-.01-3.016l8.01-8.014a2 2 0 0 1 2.81 0l8.01 8.014Z"/><path d="M9 14v1.5a3 3 0 0 0 3 3h0a3 3 0 0 0 3-3V14"/></svg>
                    </div>
                    <div class="flex text-[10px] font-bold">
                        <span class="text-gray-500 w-20">CLASS:</span>
                        <span class="text-gray-900 uppercase">{{className}}</span>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <div class="w-5 h-5 rounded flex items-center justify-center shrink-0" style="background-color: {{themeColor}};">
                        <svg class="icon" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    </div>
                    <div class="flex text-[10px] font-bold">
                        <span class="text-gray-500 w-20">HOUSE:</span>
                        <span class="text-gray-900 uppercase">{{house}}</span>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <div class="w-5 h-5 rounded flex items-center justify-center shrink-0" style="background-color: {{themeColor}};">
                        <svg class="icon" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                    </div>
                    <div class="flex text-[10px] font-bold">
                        <span class="text-gray-500 w-20">ISSUE DATE:</span>
                        <span class="text-gray-900 uppercase">{{issueDate}}</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Background Shape -->
        <div class="absolute bottom-0 left-0 w-full h-20 z-0">
            <svg viewBox="0 0 100 100" class="w-full h-full" preserveAspectRatio="none">
                <path d="M0,100 L100,100 L100,5 C70,40 30,20 0,30 Z" fill="{{themeColor}}"/>
                <path d="M0,30 C30,20 70,40 100,5 L100,10 C70,45 30,25 0,35 Z" fill="{{accentColor}}"/>
            </svg>
        </div>
    </div>


    <!-- BACK CARD -->
    <div 
        class="bg-white overflow-hidden shadow-xl relative flex flex-col shrink-0"
        style="width: 3.375in; height: 5.375in; border-radius: 1rem;"
    >
        <!-- Lanyard Hole -->
        <div class="absolute top-2 left-1/2 -translate-x-1/2 w-14 h-3 bg-gray-100 rounded-full z-50 shadow-inner border border-gray-200"></div>

        <!-- Top Background Shape -->
        <div class="absolute top-0 left-0 w-full h-[40%] z-0">
            <svg viewBox="0 0 100 100" class="w-full h-full" preserveAspectRatio="none">
                <path d="M0,0 L100,0 L100,80 C50,110 0,80 0,80 Z" fill="{{themeColor}}"/>
            </svg>
        </div>

        <div class="w-full pt-10 pb-2 flex justify-center relative z-10">
            {{#if schoolLogo}}
            <img src="{{schoolLogo}}" alt="School Logo" class="h-10 object-contain" />
            {{else}}
            <div class="h-10 flex items-center justify-center font-black text-white text-xl">{{schoolName}}</div>
            {{/if}}
        </div>

        <div class="flex-1 flex flex-col w-full px-6 relative z-10 mt-10">
            <h4 class="text-[9px] font-black text-center text-gray-900 mb-4">
                IN CASE OF EMERGENCY,<br/>PLEASE CONTACT:
            </h4>

            <div class="space-y-2 mb-4">
                <div class="flex items-start gap-3">
                    <div class="w-5 h-5 rounded-full flex items-center justify-center shrink-0 mt-0.5" style="background-color: {{themeColor}};">
                        <svg class="icon" viewBox="0 0 24 24"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>
                    <div class="flex flex-col text-[9px] font-bold">
                        <span class="text-gray-500">NAME:</span>
                        <span class="text-gray-900 uppercase">{{emergencyContactName}}</span>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="w-5 h-5 rounded-full flex items-center justify-center shrink-0 mt-0.5" style="background-color: {{themeColor}};">
                        <svg class="icon" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    </div>
                    <div class="flex flex-col text-[9px] font-bold">
                        <span class="text-gray-500">PHONE:</span>
                        <span class="text-gray-900 uppercase">{{emergencyContactPhone}}</span>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="w-5 h-5 rounded-full flex items-center justify-center shrink-0 mt-0.5" style="background-color: {{themeColor}};">
                        <svg class="icon" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                    <div class="flex flex-col text-[9px] font-bold">
                        <span class="text-gray-500">RELATIONSHIP:</span>
                        <span class="text-gray-900 uppercase">{{emergencyContactRelation}}</span>
                    </div>
                </div>
            </div>

            <div class="w-full border-t border-gray-200 mb-2"></div>

            <h4 class="text-[8px] font-black text-center text-gray-900 mb-2">TERMS & CONDITIONS</h4>
            <ul class="text-[7px] text-gray-600 font-medium space-y-1 pl-2 list-disc ml-2">
                <li>This card is the property of the school.</li>
                <li>It must be worn at all times on school premises.</li>
                <li>This card is non-transferable.</li>
                <li>Report loss of this card to the school office immediately.</li>
            </ul>
        </div>

        <!-- Bottom Background Shape & QR Code -->
        <div class="absolute bottom-0 left-0 w-full h-[25%] z-0 flex flex-col items-center justify-end pb-3">
            <svg viewBox="0 0 100 100" class="absolute bottom-0 left-0 w-full h-full z-0" preserveAspectRatio="none">
                <path d="M0,100 L100,100 L100,40 C70,10 30,30 0,20 Z" fill="{{themeColor}}"/>
                <path d="M0,20 C30,30 70,10 100,40 L100,45 C70,15 30,35 0,25 Z" fill="{{accentColor}}"/>
            </svg>
            
            <div class="bg-white p-1 rounded z-10 shadow-sm relative mb-1 -mt-8 border-2 border-white">
                <img src="{{qrCodeImage}}" alt="QR Code" style="width: 50px; height: 50px;" />
            </div>
            
            <p class="text-[7px] text-white font-medium z-10 tracking-widest uppercase opacity-90 relative">
                {{schoolWebsite}}
            </p>
        </div>
    </div>

</body>
</html>
